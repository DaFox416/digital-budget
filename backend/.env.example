# Copy to .env and adjust. Values here are local defaults.
ENVIRONMENT=local
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]
# Postgres from docker compose, reached from your machine
DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5432/budget
TEST_DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5432/budget_test
TIMEZONE=America/Mexico_City
